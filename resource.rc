// GTX Browser resources: application icon + version info + manifest.
// Compiled by build.rs with rc.exe when the Windows SDK is available;
// builds proceed without it (with a warning) if it is not.

1 ICON "assets/gtx.ico"

// RT_MANIFEST (24), id 1: Comctl32 v6 (cue banners), asInvoker, PMv2 DPI.
1 24 "gtx.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GTX"
            VALUE "FileDescription", "GTX Browser"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "gtx-browser"
            VALUE "LegalCopyright", "GTX Browser"
            VALUE "OriginalFilename", "gtx-browser.exe"
            VALUE "ProductName", "GTX Browser"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
